generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String
  email               String               @unique
  password            String
  role                String
  photoUrl            String?
  farmAddress         String?
  farmLatitude        Float?
  farmLongitude       Float?
  createdAt           DateTime             @default(now())

  vet                 Vet?
  appointments        Appointment[]        @relation("FarmerAppointments")
  reviews             Review[]
  animals             Animal[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
}

model Vet {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  user         User          @relation(fields: [userId], references: [id])
  specialty    String
  bio          String?
  photoUrl     String?
  verified     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  slots        Slot[]
  appointments Appointment[] @relation("VetAppointments")
  reviews      Review[]
}

model Slot {
  id                      Int          @id @default(autoincrement())
  vetId                   Int
  vet                     Vet          @relation(fields: [vetId], references: [id])
  startTime               DateTime
  endTime                 DateTime
  isBooked                Boolean      @default(false)
  appointmentType         String       @default("CLINIC")
  appointmentLocationName String?
  appointmentAddress      String?
  appointmentLatitude    Float?
  appointmentLongitude    Float?
  appointment             Appointment?

  @@unique([vetId, startTime])
}

model Appointment {
  id                  Int          @id @default(autoincrement())
  farmerId            Int
  farmer              User         @relation("FarmerAppointments", fields: [farmerId], references: [id])
  vetId               Int
  vet                 Vet          @relation("VetAppointments", fields: [vetId], references: [id])
  slotId              Int          @unique
  slot                Slot         @relation(fields: [slotId], references: [id])
  status              String       @default("PENDING")
  notes               String?
  appointmentType     String       @default("CLINIC")
  visitLocationName   String?
  visitAddress        String?
  visitLatitude       Float?
  visitLongitude      Float?
  createdAt           DateTime      @default(now())
  review              Review?
}

model Review {
  id            Int         @id @default(autoincrement())
  farmerId      Int
  farmer        User        @relation(fields: [farmerId], references: [id])
  vetId         Int
  vet           Vet         @relation(fields: [vetId], references: [id])
  appointmentId Int         @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
}

model Animal {
  id            Int           @id @default(autoincrement())
  farmerId      Int
  farmer        User          @relation(fields: [farmerId], references: [id])
  name          String
  species       String
  breed         String?
  gender        String?
  birthDate     DateTime?
  tagNumber     String?       @unique
  photoUrl      String?
  createdAt     DateTime      @default(now())
  treatments    Treatment[]
  vaccinations Vaccination[]
}

model Treatment {
  id            Int        @id @default(autoincrement())
  animalId      Int
  animal        Animal     @relation(fields: [animalId], references: [id])
  diagnosis     String
  treatment     String
  medicine      String?
  notes         String?
  treatmentDate DateTime   @default(now())
  followUpDate  DateTime?
  createdAt     DateTime   @default(now())
}

model Vaccination {
  id             Int       @id @default(autoincrement())
  animalId       Int
  animal         Animal    @relation(fields: [animalId], references: [id])
  vaccineName    String
  administeredAt DateTime
  nextDueAt      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}